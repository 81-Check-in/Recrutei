# ══════════════════════════════════════════════════════════
#  RECRUTEI — Variáveis de ambiente
#  Copie para .env e preencha. NUNCA faça commit do .env.
# ══════════════════════════════════════════════════════════

# ── Supabase ──
# Painel > Project Settings > API
SUPABASE_URL=https://iragwjfaczpfbldbgsjv.supabase.co
# service_role — acesso total, ignora RLS. NUNCA no frontend.
SUPABASE_SERVICE_KEY=

# ── Claude API ──
# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# ── E-mail (Locaweb) ──
IMAP_SERVIDOR=email-ssl.com.br
IMAP_PORTA=993
IMAP_USUARIO=vagas@suaempresa.com.br
IMAP_SENHA=
IMAP_PASTA_ENTRADA=INBOX
# Só processa e-mails não lidos recebidos a partir desta data (AAAA-MM-DD).
# Vazio = todos os não lidos. Use para não reprocessar um acúmulo antigo.
IMAP_DESDE=

# ── Privacidade ──
# Chave secreta do hash de identidade (detecção de reenvios). Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Guarde-a: se mudar depois de gravar candidatos, reenvios antigos não são mais
# detectados. NUNCA no frontend, NUNCA faça commit.
IDENTIDADE_CHAVE=

# ── Execução ──
# true = não grava nada, só simula (use no primeiro teste)
MODO_SIMULACAO=false
# Máximo de e-mails por execução (0 = sem limite)
LIMITE_EMAILS=0
# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── Servidor HTTP (api.py) — só o serviço "web" de avaliação imediata usa isto ──
# Chave pública do projeto (Painel > Project Settings > API > "Publishable key"),
# a mesma embutida em frontend/js/nucleo.js. Não é segredo. Vazio usa o valor padrão
# já embutido em config.py (só troque se rotacionar a chave no Supabase).
SUPABASE_PUBLISHABLE_KEY=
# Origens que podem chamar o endpoint de avaliação imediata (CORS), separadas por
# vírgula — ex.: https://recrutei.vercel.app. Vazio = aceita qualquer origem.
CORS_ORIGENS=

# ── Aviso de sanitização por e-mail (opcional) ──
# A lista de sugestões de sanitização do Banco de Talentos aparece sempre dentro do sistema. Se você quiser também
# um e-mail de aviso, cadastre os destinatários no painel (Configurações → sanitizacao_emails_aviso). O e-mail só
# traz contagens, nunca dados de candidato. Sem SMTP_* abaixo, usa a mesma conta e o mesmo servidor do IMAP
# (a Locaweb atende IMAP e SMTP em email-ssl.com.br; porta 465 = SSL direto, 587 = STARTTLS).
SMTP_SERVIDOR=
SMTP_PORTA=465
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=
# Endereço do painel publicado (Vercel), para o link "Abrir o painel" do e-mail. Vazio = e-mail sem link.
PAINEL_URL=
